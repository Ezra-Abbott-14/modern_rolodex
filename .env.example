# Copy this file to .env and put your real key only in .env (Git ignores it).
GEMINI_API_KEY=
# Optional: change the model without editing server.py.
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8000
# Local mode stays on this machine. Hosted mode requires all settings in DEPLOYMENT.md.
APP_ENV=development
HOST=127.0.0.1
# Optional local sign-in. Required (12+ random characters) for production.
DEMO_ACCESS_CODE=
# Required (32+ random characters) for production; keep this secret and stable.
SESSION_SECRET=
# Hosted production example: https://rolodex.your-domain.example (no trailing path).
PUBLIC_ORIGIN=
# Set to 1 only behind a private AWS HTTPS proxy that replaces X-Forwarded-Proto.
TRUST_PROXY=0
# MySQL/RDS persistence. Keep these values private in .env or the host's secret settings.
DB_HOST=
DB_PORT=3306
DB_NAME=rolodexi
DB_USER=
DB_PASSWORD=
